#!/usr/bin/env python3
"""A local, read-only board of every factory job. Serves on 127.0.0.1 only.

    factory/bin/dashboard            # http://127.0.0.1:8765
    factory/bin/dashboard --port 9000
"""
from __future__ import annotations

import argparse
import json
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip() or ".").resolve()
JOBS = ROOT / "factory" / "jobs"
PAGE = Path(__file__).resolve().parent.parent / "dashboard" / "index.html"


def jobs() -> list[dict]:
    out = []
    for p in sorted(JOBS.glob("*/job.json")) if JOBS.exists() else []:
        try:
            out.append(json.loads(p.read_text()))
        except (OSError, json.JSONDecodeError):      # a job file caught mid-write; it will be there next time
            continue
    return out


class Handler(BaseHTTPRequestHandler):
    def _send(self, code: int, body: bytes, kind: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Security-Policy", "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:                         # noqa: N802
        # Answer only requests addressed to this machine by name, so a web page that points a
        # hostname at 127.0.0.1 cannot read the board.
        port = self.server.server_address[1]
        if self.headers.get("Host", "") not in (f"127.0.0.1:{port}", f"localhost:{port}"):
            self._send(403, b"forbidden", "text/plain")
            return
        if self.path == "/api/jobs":
            self._send(200, json.dumps({"repo": ROOT.name, "jobs": jobs()}).encode(), "application/json")
        elif self.path in ("/", "/index.html"):
            self._send(200, PAGE.read_bytes(), "text/html; charset=utf-8")
        else:
            self._send(404, b"not found", "text/plain")

    def log_message(self, *args) -> None:
        pass


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--port", type=int, default=8765)
    a = p.parse_args()
    server = ThreadingHTTPServer(("127.0.0.1", a.port), Handler)
    print(f"factory board for {ROOT.name}: http://127.0.0.1:{a.port}  (Ctrl-C to stop)", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
